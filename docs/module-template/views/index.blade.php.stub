    @include("$prefix.layout.script")
    <script>
        function postAction(url, confirmText) {
            Swal.fire({
                title: confirmText,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Confirm',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (!result.isConfirmed) {
                    return;
                }

                loadingSwal();
                $.ajax({
                    url: url,
                    type: 'POST',
                    data: {
                        _token: "{{ csrf_token() }}"
                    },
                    success: function () {
                        location.reload();
                    },
                    error: function () {
                        Swal.fire('Error', 'Cannot process this item.', 'error');
                    }
                });
            });
        }

        function deleteItem(id) {
            postAction("{{ url("$segment/$folder/destroy") }}/" + id, 'Confirm delete?');
        }

        function toggleStatus(id) {
            postAction("{{ url("$segment/$folder/status") }}/" + id, 'Confirm status change?');
        }
    </script>
</body>

